{
  "buildCommand": "ng build",
  "outputDirectory": "dist/candle-ai/browser",
  "rewrites": [
    {
      "source": "/api/yahoo/v8/finance/chart/:symbol",
      "destination": "https://query1.finance.yahoo.com/v8/finance/chart/:symbol"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
